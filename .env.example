APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
# Base URL for links embedded in outgoing email (activation, welcome,
# admin invitations). MUST be an address the RECIPIENT can reach — set it
# to the real production domain on deploy, and to this machine's LAN IP
# for testing. Left as localhost, every emailed link resolves to the
# reader's own machine and fails for anyone but the developer, with no
# server-side trace because the click never arrives.
FRONTEND_URL=https://set-the-real-domain-here

# Comma-separated list of origins allowed to call the API (config/cors.php).
# e.g. CORS_ALLOWED_ORIGINS=https://vkonnect.app,https://staging.vkonnect.app
CORS_ALLOWED_ORIGINS=

# Seeded Super Admin / HR Admin passwords (database/seeders/DatabaseSeeder.php).
# REQUIRED EVERYWHERE, including local dev. There is no fallback: the seeder
# throws if either is unset, because a hardcoded default password once got
# seeded silently on config-cached environments. Set both before running
# `./backend-cli.ps1 setup`, or the seed step stops with an error naming the
# missing variable.
STAGING_ADMIN_PASSWORD=Manikanta@123
STAGING_HR_PASSWORD=set-a-strong-password-here

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vkonnect
DB_USERNAME=set-the-app-db-user-here
DB_PASSWORD=set-the-app-db-password-here


# Test-suite database (see the mysql_testing connection in config/database.php).
# Deliberately a different user with no grant on the application schema:
# the suite runs migrate:fresh, which drops every table.
DB_TEST_DATABASE=vkonnect_test
DB_TEST_USERNAME=vkonnect_test
DB_TEST_PASSWORD=set-the-test-db-password-here

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# database is used here so the app runs with zero extra setup; production
# worker restarts/deploys and don't compete with web request DB connections.
QUEUE_CONNECTION=database
# Where failed jobs are recorded.
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=graph
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="alumni@vkollab.com"
MAIL_FROM_NAME="${APP_NAME}"

# Microsoft Graph mail transport. Set MAIL_MAILER=graph to send OTP/notification/
# welcome emails through Microsoft 365 instead of SMTP/log. Requires an Azure AD
# app registration with Mail.Send (Application permission, admin-consented).
MS_GRAPH_TENANT_ID=81d52c90-a1c1-4fd1-b21c-d6dae73962ec
MS_GRAPH_CLIENT_ID=9c9b9548-aa35-47fa-a450-450b6cbdb4c7
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER=alumni@vkollab.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Blind index for PAN lookup/uniqueness (see .env). Generate with:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32));"
PAN_HASH_KEY=b2a16ed2997b92605f6869ac110a828c9055a7be2b0c0e61cc76f1e96d860a90
